---
// 왼쪽 README 카드 — sanitize 된 HTML 주입 (prose-emerald)
// 우측 상단 복사 버튼은 원본 Markdown 을 클립보드에 쓴다 (HTML 아님)
interface Props {
  html: string;
  markdown: string;
}
const { html, markdown } = Astro.props;

// 원본 Markdown 을 inline JSON 으로 직렬화 — `</script>` 가 본문에 있어도 안전하도록 `<` 를 유니코드 escape
const markdownJson = JSON.stringify(markdown).replace(/</g, '\\u003c');
---

<section class="readme-card">
  <div class="readme-card-head">
    <div class="head-left">
      <span class="material-symbols-outlined" aria-hidden="true">description</span>
      <span class="head-title" data-i18n="readme_heading">README.md</span>
    </div>
    <button
      type="button"
      class="copy-btn"
      id="readme-copy-btn"
      aria-label="README 복사"
      data-i18n-arialabel="readme_copy"
    >
      <span class="material-symbols-outlined" aria-hidden="true">content_copy</span>
    </button>
  </div>
  <script
    type="application/json"
    id="readme-source"
    set:html={markdownJson}
  />
  <div class="readme-card-body prose-emerald" set:html={html}></div>
</section>

<script>
  import { dictionaries, getCurrentLang } from '../../i18n/dictionary';

  function initReadmeCopy(): void {
    const btn = document.getElementById('readme-copy-btn');
    const source = document.getElementById('readme-source');
    if (!btn || !source) return;

    let markdown = '';
    try {
      markdown = JSON.parse(source.textContent ?? '""');
    } catch {
      // 파싱 실패 → 버튼 숨김 (인터랙션 차단)
      btn.setAttribute('hidden', '');
      return;
    }

    const icon = btn.querySelector<HTMLElement>('.material-symbols-outlined');
    const toastEl = document.getElementById('global-toast');
    let resetTimer: ReturnType<typeof setTimeout> | null = null;
    let toastTimer: ReturnType<typeof setTimeout> | null = null;

    btn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(markdown);
      } catch {
        // 권한 거부 / non-secure context 등 — 조용히 무시
        return;
      }

      // 아이콘 일시 변경 (content_copy → check)
      if (icon) icon.textContent = 'check';
      if (resetTimer) clearTimeout(resetTimer);
      resetTimer = setTimeout(() => {
        if (icon) icon.textContent = 'content_copy';
      }, 2000);

      // 토스트 (filter.ts 와 동일한 #global-toast 재사용)
      if (toastEl) {
        const dict = dictionaries[getCurrentLang()];
        toastEl.textContent = dict.readme_copy_done;
        toastEl.classList.remove('opacity-0', 'translate-y-2');
        if (toastTimer) clearTimeout(toastTimer);
        toastTimer = setTimeout(() => {
          toastEl.classList.add('opacity-0', 'translate-y-2');
        }, 2000);
      }
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initReadmeCopy);
  } else {
    initReadmeCopy();
  }
</script>
