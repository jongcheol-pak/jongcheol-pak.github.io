---
// 상세 페이지 우측 패널 — 최근 4주 주별 commit 수 미니 sparkline (B-3)
// SVG polyline + 4개 노드. 노드 hover 시 `<title>` 로 해당 주 커밋 수 툴팁
// 호출자에서 `weeks.some((v) => v > 0)` 가드를 거친 뒤에만 렌더한다 (0커밋 저장소 폴백)
interface Props {
  weeks: number[]; // 길이 4, 오래된 주 → 최신 주 순서
}
const { weeks } = Astro.props;

const W = 100; // SVG 좌표계 너비 (실제 표시 너비는 CSS 가 결정)
const H = 28;  // SVG 좌표계 높이
const PAD = 3; // 노드 반지름 여유 패딩 (잘림 방지)

const max = Math.max(...weeks, 1);
const stepX = weeks.length > 1 ? (W - PAD * 2) / (weeks.length - 1) : 0;
const points = weeks.map((v, i) => ({
  x: PAD + i * stepX,
  y: PAD + (1 - v / max) * (H - PAD * 2),
  v,
}));
const polylinePoints = points.map((p) => `${p.x.toFixed(2)},${p.y.toFixed(2)}`).join(' ');
const totalCommits = weeks.reduce((a, b) => a + b, 0);
---

<section class="activity-spark" aria-label={`Recent commits last 4 weeks: ${totalCommits}`}>
  <div class="activity-spark-head">
    <span class="material-symbols-outlined activity-spark-icon" aria-hidden="true">timeline</span>
    <span class="activity-spark-label" data-i18n="activity_spark_label">LAST_4_WEEKS</span>
    <span class="activity-spark-total">{totalCommits}</span>
  </div>
  <svg viewBox={`0 0 ${W} ${H}`} class="activity-spark-svg" preserveAspectRatio="none" aria-hidden="true">
    <polyline points={polylinePoints} fill="none" stroke="currentColor" stroke-width="1.5" />
    {points.map((p) => (
      <circle cx={p.x} cy={p.y} r="2.5">
        <title>{`${p.v} commits`}</title>
      </circle>
    ))}
  </svg>
</section>
