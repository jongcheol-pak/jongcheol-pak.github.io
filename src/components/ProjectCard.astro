---
// 저장소 카드 (Bento 스타일, Emerald Cybernetic)
// - 이미지 상단 (h-48) + 설명 + 칩 2개 (topics[0], topics[1]) + Updated 상대시간
// - 좌상단 북마크 별, 우상단 archived/fork 배지
// - data-* 속성은 src/scripts/filter.ts 가 검색/필터/정렬에 사용 (유지)
import type { RepoCardData } from '../lib/types';
import { withBase } from '../lib/paths';
import Icon from './Icon.astro';

interface Props {
  card: RepoCardData;
}
const { card } = Astro.props;

// 카드 썸네일: README 첫 이미지 → 폴백 Thumbnail.jpg
const thumb = card.imageUrl ?? withBase('/Thumbnail.jpg');
const detailHref = withBase(`/${card.name}/`);

// data-name/북마크 키/URL 은 원본 name 유지 — 식별자 안정성 (외부 링크/저장된 북마크 깨짐 방지)
const titleText = card.displayName ?? card.name;

// 검색 대상은 모두 lowercase 로 미리 정규화 (filter.ts 가 일관성 유지)
const dataName = card.name.toLowerCase();
const dataDescription = (card.description ?? card.summary ?? '').toLowerCase();
const dataTopics = card.topics.join(',');

// 칩 1 / 칩 2 — 표시 텍스트는 uppercase, data-topic 은 FilterBar checkbox value 와 매칭되도록 lowercase 원문
const topic1 = card.topics[0] ?? null;
const topic2 = card.topics[1] ?? null;
const chip1 = topic1?.toUpperCase() ?? null;
const chip2 = topic2?.toUpperCase() ?? null;
---

<article
  class="card repo-card"
  data-name={dataName}
  data-description={dataDescription}
  data-topics={dataTopics}
  data-stars={String(card.stars)}
  data-updated={card.updatedAt}
  data-created={card.createdAt}
  data-archived={card.archived ? '1' : '0'}
  data-fork={card.fork ? '1' : '0'}
>
  <div class="card-image">
    <a href={detailHref} aria-label={`${titleText} 상세 페이지`}>
      <img src={thumb} alt={`${titleText} 썸네일`} loading="lazy" />
    </a>

    <!-- 북마크 버튼 (좌상단) -->
    <button
      type="button"
      class="bookmark-btn"
      data-repo-name={dataName}
      aria-pressed="false"
      aria-label="북마크 추가"
      data-i18n-arialabel="bookmark_add"
    >
      <Icon name="star" class="icon-star-outline" />
      <Icon name="star_filled" class="icon-star-filled" />
    </button>

    <!-- archived / fork 배지 (우상단) -->
    {card.archived && (
      <div class="card-badge-secondary" data-i18n="badge_archived">ARCHIVED</div>
    )}
    {!card.archived && card.fork && (
      <div class="card-badge-secondary" data-i18n="badge_fork">FORK</div>
    )}
  </div>

  <div class="card-content">
    <h3 class="card-title">
      <a href={detailHref}>{titleText}</a>
    </h3>

    {(card.description || card.summary) && (
      <p class="card-desc">{card.description ?? card.summary}</p>
    )}

    <div class="card-chips">
      {chip1 && topic1 && (
        <button type="button" class="card-chip" data-topic={topic1.toLowerCase()} aria-pressed="false">{chip1}</button>
      )}
      {chip2 && topic2 && (
        <button type="button" class="card-chip alt" data-topic={topic2.toLowerCase()} aria-pressed="false">{chip2}</button>
      )}
    </div>

    {card.languages && card.languages.length > 0 && (
      <div class="card-langs" role="img" aria-label={`Top languages: ${card.languages.map((l) => `${l.name} ${(l.ratio * 100).toFixed(0)}%`).join(', ')}`}>
        {card.languages.map((l, i) => (
          <span
            class="card-lang-seg"
            data-rank={i}
            style={`width: ${(l.ratio * 100).toFixed(2)}%`}
            title={`${l.name} ${(l.ratio * 100).toFixed(1)}%`}
          />
        ))}
      </div>
    )}

    <div class="card-footer">
      <span class="card-updated">
        <span data-i18n="card_updated_prefix">Updated:</span>
        &nbsp;<span data-iso={card.updatedAt}>{card.updatedAt}</span>
      </span>
      {(card.stars > 0 || card.openIssues > 0) && (
        <span class="card-meta-right">
          {card.stars > 0 && (
            <span class="card-stars" aria-label={`${card.stars} stars`}>
              <Icon name="star_filled" />
              <span class="card-stars-num">{card.stars}</span>
            </span>
          )}
          {card.openIssues > 0 && (
            <span class="card-open-issues">
              <span data-i18n="open_issues_label">OPEN ISSUES</span>
              <span class="card-open-issues-num">{card.openIssues}</span>
            </span>
          )}
        </span>
      )}
    </div>
  </div>
</article>
